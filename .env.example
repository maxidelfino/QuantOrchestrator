# =============================================================================
# QuantOrchestrator — Environment Variables (SECRETS ONLY)
# =============================================================================
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
# .env is for SECRETS ONLY (API keys, wallet addresses, private keys).
# Bot-specific parameters (exchange, strategy, risk) go in:
#   bots/<bot_name>/config.yaml
#
# =============================================================================

# ---------------------------------------------------------------------------
# Hyperliquid Credentials
# ---------------------------------------------------------------------------
# Wallet address (starts with 0x)
# Get this from your Hyperliquid wallet page.
HYPERLIQUID_WALLET_ADDRESS=0xyour_wallet_address_here

# Private key (starts with 0x)
# SECURITY WARNING:
#   - The private key gives FULL ACCESS to your wallet.
#   - Use a dedicated wallet with only the funds you're willing to risk.
#   - NEVER use your main wallet's private key.
#   - Store .env securely (e.g., encrypted volume, secrets manager).
HYPERLIQUID_PRIVATE_KEY=0xyour_private_key_here

# ---------------------------------------------------------------------------
# Binance API Credentials
# ---------------------------------------------------------------------------
# Required ONLY if using Binance Futures as venue.
#
# SECURITY WARNING:
#   - Anyone with these keys can trade with your funds.
#   - Use API keys with "Futures Trading" permission ONLY.
#   - Never enable withdrawal permissions.
#   - IP-whitelist your API keys when possible.
#
# Get them from: https://www.binance.com/en/my/settings/api-management
#
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# ---------------------------------------------------------------------------
# Shared Bot Behavior (optional)
# ---------------------------------------------------------------------------

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
BOT_LOG_LEVEL=INFO
