# Exchange selection: binance | hyperliquid
BOT_EXCHANGE=hyperliquid

# Binance API credentials (required only if BOT_EXCHANGE=binance)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Hyperliquid signer credentials (required only if BOT_EXCHANGE=hyperliquid)
HYPERLIQUID_WALLET_ADDRESS=0xyour_wallet_address
HYPERLIQUID_PRIVATE_KEY=0xyour_private_key
# Optional override (defaults to Hyperliquid testnet when BOT_TESTNET=true)
HYPERLIQUID_BASE_URL=https://api.hyperliquid-testnet.xyz

# Bot settings
BOT_SYMBOL=BTC/USDC:USDC
BOT_TESTNET=true
BOT_LEVERAGE=1
BOT_RISK_PCT=0.02
BOT_STOP_ATR_MULT=3.0
BOT_MAX_DAILY_LOSS=0.05
BOT_MAX_DRAWDOWN=0.25
BOT_LOG_LEVEL=INFO
BOT_POLL_INTERVAL=60
