{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist"
  },
  "include": ["index.ts", "bots/**/*.ts", "cli/**/*.ts", "backtest/**/*.ts", "pricing/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
